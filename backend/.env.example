PORT=3001
DATABASE_URL="postgresql://postgres:password@localhost:5432/wealthgift"
JWT_SECRET=supersecret_change_in_production
JWT_EXPIRES_IN=7d
ALPACA_BROKER_KEY=mock
ALPACA_BROKER_SECRET=mock
ALPACA_BASE_URL=https://broker-api.sandbox.alpaca.markets

# Broker selector — 'mock' (default) | 'alpaca' | 'drivewealth'.
# Leave as-is until the DriveWealth sandbox is verified end-to-end.
# BROKER=mock

# DriveWealth (sandbox / UAT) — fill from your DriveHub once provisioned.
# Nothing uses these until BROKER=drivewealth (see drivewealth.service.ts).
# DRIVEWEALTH_BASE_URL=https://bo-api.sandbox.drivewealth.com
# DRIVEWEALTH_APP_KEY=
# DRIVEWEALTH_USERNAME=
# DRIVEWEALTH_PASSWORD=
# DRIVEWEALTH_PARENT_IB_ID=
# DRIVEWEALTH_ACCOUNT_TYPE=

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=WealthGift <noreply@wealthgift.app>
FRONTEND_URL=http://localhost:5173
