datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  name               String
  subscriptionStatus SubscriptionStatus @default(BASIC)
  stripeCustomerId   String?
  passwordResetCode   String?
  passwordResetExpiry DateTime?
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?   @unique
  createdAt          DateTime           @default(now())
  gifts              Gift[]
  subscription       Subscription?
  etfRatings         ETFRating[]
  savedRecipients    SavedRecipient[]
  favoriteRecipients FavoriteRecipient[]
  createdEvents      GiftEvent[]

  @@index([stripeCustomerId])
}

model Gift {
  id              String     @id @default(uuid())
  senderId        String
  sender          User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  recipientName   String
  occasion        String
  etfSymbol       String
  amount          Float
  commission      Float      @default(0)
  note            String?
  deliveryDate    DateTime?
  status          GiftStatus @default(PENDING)
  claimToken      String     @unique @default(uuid())
  alpacaAccountId String?
  alpacaOrderId   String?
  paymentIntentId String?  @unique
  recipientEmail  String?
  redeemedAmount  Float?
  claimPin        String?
  claimPinExpiry  DateTime?
  claimEmailSentAt DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  kyc             KYC?
  agreement       Agreement?
  payment         Payment?

  @@index([senderId])
  @@index([recipientEmail])
  @@index([status])
  @@index([deliveryDate])
}

model KYC {
  id         String    @id @default(uuid())
  giftId     String    @unique
  gift       Gift      @relation(fields: [giftId], references: [id], onDelete: Cascade)
  fullName   String
  dob        String
  ssnLast4   String
  address    String
  city       String
  state      String
  zip        String
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Agreement {
  id              String   @id @default(uuid())
  giftId          String   @unique
  gift            Gift     @relation(fields: [giftId], references: [id], onDelete: Cascade)
  signatureBase64 String
  agreedToTerms   Boolean  @default(true)
  signedAt        DateTime @default(now())
}

model Subscription {
  id                   String           @id @default(uuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan @default(BASIC)
  stripeSubscriptionId String?
  stripeCustomerId     String?
  status               String           @default("active")
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Payment {
  id                    String        @id @default(uuid())
  giftId                String        @unique
  gift                  Gift          @relation(fields: [giftId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String        @unique
  amount                Float
  commission            Float         @default(0)
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model ETFRating {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  etfSymbol String
  stars     Int
  role      RatingRole @default(SENDER)
  comment   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, etfSymbol, role])
}

enum GiftStatus {
  PENDING
  CLAIMING
  KYC_SUBMITTED
  KYC_VERIFIED
  AGREEMENT_SIGNED
  ACCOUNT_CREATING
  INVESTED
  FAILED
  REDEEMED
  CANCELLED
}

enum SubscriptionStatus {
  BASIC
  PRO
  PRO_PLUS
}

enum SubscriptionPlan {
  BASIC
  PRO
  PRO_PLUS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum RatingRole {
  SENDER
  RECEIVER
}

model SavedRecipient {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  createdAt DateTime @default(now())

  @@unique([userId, email])
}

model FavoriteRecipient {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail String
  recipientName  String
  etfSymbol      String
  amount         Float
  schedules      FavoriteSchedule[]
  createdAt      DateTime           @default(now())

  @@unique([userId, recipientEmail])
}

model FavoriteSchedule {
  id                  String            @id @default(uuid())
  favoriteRecipientId String
  favoriteRecipient   FavoriteRecipient @relation(fields: [favoriteRecipientId], references: [id], onDelete: Cascade)
  month               Int
  day                 Int
  label               String?
  lastSentAt          DateTime?
  createdAt           DateTime          @default(now())

  @@index([favoriteRecipientId])
}

model GiftEvent {
  id           String                 @id @default(uuid())
  creatorId    String
  creator      User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  etfSymbol    String
  targetAmount Float
  status       GiftEventStatus        @default(ACTIVE)
  participants GiftEventParticipant[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([creatorId])
}

model GiftEventParticipant {
  id          String            @id @default(uuid())
  eventId     String
  event       GiftEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email       String
  name        String
  status      ParticipantStatus @default(INVITED)
  giftId      String?           @unique
  inviteToken String            @unique @default(uuid())
  acceptedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@unique([eventId, email])
  @@index([email])
  @@index([eventId])
}

enum GiftEventStatus {
  ACTIVE
  CLOSED
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  GIFTED
}
